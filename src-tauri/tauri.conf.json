{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anywhere Plamo",
  "version": "0.2.3",
  "identifier": "app.anywhere-plamo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Anywhere Plamo",
      "width": 780,
      "height": 620,
      "minWidth": 360,
      "minHeight": 520,
      "visible": false,
      "center": true
    }, {
      "label": "popup",
      "url": "index.html?popup",
      "title": "Anywhere Plamo — 選択翻訳",
      "width": 560,
      "height": 440,
      "minWidth": 360,
      "minHeight": 340,
      "visible": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNTkxRjlCRTE1QTc2NzQKUldSMGRscmhteDlaM3hlVDVVYVlqZktRZWFrZXQwL2hYUTFRZmQxMDBNWTBFck1vZnZtandPL1gK",
      "endpoints": ["https://github.com/romanohu/anywhere-plamo/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private, offline translation with PLaMo",
    "resources": ["resources/runtime/"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.3", "signingIdentity": "-" }
  }
}
